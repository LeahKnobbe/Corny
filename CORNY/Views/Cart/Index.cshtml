@model CORNY.Models.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (!Model.Items.Any())
{
    <p class="text-muted">Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Price</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td class="text-end">$@item.Product.Pricing.ToString("0.00")</td>
                    <td class="text-end">
                        <form asp-action="Update" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Product.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control d-inline-block w-auto text-end" />
                            <button type="submit" class="btn btn-link p-0 ms-2">Update</button>
                        </form>
                    </td>
                    <td class="text-end">$@item.LineTotal.ToString("0.00")</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Product.ProductId" />
                            <button type="submit" class="btn btn-link p-0">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Cart Total</th>
                <th class="text-end">$@Model.Total.ToString("0.00")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}