@model IReadOnlyList<CORNY.Models.ViewModels.OrderDisplayViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

@if (Model.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th>Shipping Address</th>
                <th>Items</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToString("g")</td>
                    <td>@order.Status</td>
                    <td>$@order.TotalOrderCost.ToString("0.00")</td>
                    <td>@order.ShippingAddress</td>
                    <td>
                        @if (order.Items.Count == 0)
                        {
                            <span>None</span>
                        }
                        else
                        {
                            <ul class="mb-0">
                                @foreach (var item in order.Items)
                                {
                                    <li>
                                        @item.ProductName — Qty @item.Quantity — $@item.PriceWhenPlaced.ToString("0.00")
                                    </li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}