@model CORNY.Models.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ImageUrl" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Sizing"></label>
        <input asp-for="Sizing" class="form-control" />
        <span asp-validation-for="Sizing" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="InventoryQuantity"></label>
        <input asp-for="InventoryQuantity" class="form-control" />
        <span asp-validation-for="InventoryQuantity" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="IsForSale"></label>
        <input asp-for="IsForSale" class="form-check-input" />
        <span asp-validation-for="IsForSale" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Pricing"></label>
        <input asp-for="Pricing" class="form-control" />
        <span asp-validation-for="Pricing" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FarmId"></label>
        <input asp-for="FarmId" class="form-control" />
        <span asp-validation-for="FarmId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <input asp-for="CategoryId" class="form-control" />
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ImageFiles">Add Images</label>
        <input asp-for="ImageFiles" type="file" class="form-control" multiple />
        <span asp-validation-for="ImageFiles" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@if (Model.ExistingImages.Count > 0)
{
    <div class="form-group mt-4">
        <label>Current Images</label>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var image in Model.ExistingImages)
            {
                <div class="card" style="width: 180px;">
                    <img class="card-img-top" src="@image.ImageUrl" alt="Product image" />
                    <div class="card-body d-grid gap-2">
                        @if (image.IsPrimary)
                        {
                            <span class="badge bg-secondary">Primary</span>
                        }

                        <form asp-action="DeleteImage" asp-controller="Product" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ProductId" />
                            <input type="hidden" name="isPrimary" value="@image.IsPrimary" />
                            @if (image.ProductImageId.HasValue)
                            {
                                <input type="hidden" name="imageId" value="@image.ProductImageId.Value" />
                            }
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}