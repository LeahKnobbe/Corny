@model IEnumerable<DataAccessLayer.Entities.ProductModel>

@{
    ViewData["Title"] = "Index";

    const int descriptionWordLimit = 12;
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Photo</th>
            <th>@Html.DisplayNameFor(model => model.ProductId)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.Sizing)</th>
            <th>@Html.DisplayNameFor(model => model.InventoryQuantity)</th>
            <th>@Html.DisplayNameFor(model => model.IsForSale)</th>
            <th>@Html.DisplayNameFor(model => model.Pricing)</th>
            <th>@Html.DisplayNameFor(model => model.FarmId)</th>
            <th>@Html.DisplayNameFor(model => model.CategoryId)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                ? $"https://via.placeholder.com/90x70?text={Uri.EscapeDataString(item.Name)}"
                : item.ImageUrl;

            var words = (item.Description ?? string.Empty)
                .Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var shortDescription = words.Length > descriptionWordLimit
                ? string.Join(' ', words.Take(descriptionWordLimit)) + "..."
                : item.Description;

            <tr>
                <td>
                    <img src="@imageUrl" alt="@item.Name" width="90" height="70" style="object-fit: cover;" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.ProductId)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@shortDescription</td>
                <td>@Html.DisplayFor(modelItem => item.Sizing)</td>
                <td>@Html.DisplayFor(modelItem => item.InventoryQuantity)</td>
                <td>@Html.DisplayFor(modelItem => item.IsForSale)</td>
                <td>@Html.DisplayFor(modelItem => item.Pricing)</td>
                <td>@Html.DisplayFor(modelItem => item.FarmId)</td>
                <td>@Html.DisplayFor(modelItem => item.CategoryId)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link p-0">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>