<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CORNY</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CORNY.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="@(ViewData["NavbarClass"] ?? "corny-navbar")">
            <div class="container-fluid">
                <a class="corny-brand" asp-area="" asp-controller="Home" asp-action="Index">Corny</a>

                <div class="corny-nav">
                    <ul class="corny-nav-links">
                        <li>
                            <a class="corny-link @(controller == "Home" && action == "Index" ? "active" : "")" 
                               asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="dropdown">
                            <a class="corny-link dropdown-toggle @(controller == "Product" && (action == "Fruit" || action == "Vegetables" || action == "Produce") ? "active" : "")" 
                               href="#" id="produceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Produce
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="produceDropdown">
                                <li><a class="dropdown-item" href="/Produce/Fruit">Fruit</a></li>
                                <li><a class="dropdown-item" href="/Produce/Vegetables">Vegetable</a></li>
                            </ul>
                        </li>
                        <li><a class="corny-link @(controller == "Product" && action == "Meat" ? "active" : "")" href="/Meat">Meat</a></li>
                        <li><a class="corny-link @(controller == "Product" && action == "AnimalProduct" ? "active" : "")" href="/AnimalProduct">Animal Product</a></li>
                        <li><a class="corny-link @(controller == "RecipeSuggestion" ? "active" : "")" 
                               asp-controller="RecipeSuggestion" asp-action="Index">Recipe Suggestions</a></li>
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("1"))
                        {
                            <li class="dropdown">
                                <a class="corny-link dropdown-toggle @(controller == "User" || controller == "Product" || controller == "Order" ? "active" : "")" 
                                   href="#" id="adminDashboard" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin Dashboard
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDashboard">
                                    <li><a class="dropdown-item" href="/User/Index">User Index</a></li>
                                    <li><a class="dropdown-item" href="/Product/Index">Product Index</a></li>
                                    <li><a class="dropdown-item" href="/Order/Index">Order Index</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="corny-actions">
    <form class="corny-search" asp-controller="Home" asp-action="Index" method="get" role="search">
        <span class="corny-search__icon">🔍</span>
        <input type="search"
               name="search"
               value="@Context.Request.Query["search"]"
               placeholder="Search"
               aria-label="Search" />
    </form>

    <div class="dropdown corny-user-dropdown">
        <button class="corny-icon-button dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="~/images/UserIconCropped.png" alt="User menu" />
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <li><a class="dropdown-item" href="/Order/MyOrders">My Orders</a></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="corny-dropdown-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">Logout</button>
                    </form>
                </li>
            }
            else
            {
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Sign up</a></li>
                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
            }
        </ul>
    </div>

    <a class="corny-icon-button" asp-controller="Cart" asp-action="Index" title="Cart">
        <img src="~/images/CartIconCropped.png" alt="Cart" />
    </a>
</div>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(ViewData["MainClass"] ?? "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CORNY - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div id="cart-toast" class="alert alert-success cart-toast" role="alert">
            @cartMessage
        </div>
    }
    <script>
        (function () {
          var host = document.querySelector('.cart-toast');
          if (!host) return;

          // If the toast persists across pages, remove it automatically
          window.setTimeout(function () {
            host.remove();
          }, 3000);
        })();
    </script>
</body>
</html>