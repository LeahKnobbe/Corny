<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CORNY</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CORNY.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="@(ViewData["NavbarClass"] ?? "corny-navbar")">
            <div class="container-fluid">
                <a class="corny-brand" asp-area="" asp-controller="Home" asp-action="Index">Corny</a>

                <div class="corny-nav">
                    <ul class="corny-nav-links">
                        <li>
                            <a class="corny-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="dropdown">
                            <a class="corny-link dropdown-toggle" href="#" id="produceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Produce
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="produceDropdown">
                                <li><a class="dropdown-item" href="/Produce/Fruit">Fruit</a></li>
                                <li><a class="dropdown-item" href="/Produce/FruitCoded">Fruit (Coded)</a></li>
                            </ul>
                        </li>
                        <li><a class="corny-link" href="#">Meat</a></li>
                        <li><a class="corny-link" href="#">Animal Product</a></li>
                    </ul>

                    <div class="corny-actions">
                        <div class="corny-search">
                            <span class="corny-search__icon">🔍</span>
                            <input type="search" placeholder="Search" aria-label="Search" />
                        </div>

                        <div class="dropdown corny-user-dropdown">
                            <button class="corny-icon-button dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="~/images/User_Icon.png" alt="User menu" />
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                                @if (User?.Identity?.IsAuthenticated ?? false)
                                {
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="corny-dropdown-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Sign up</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                }
                            </ul>
                        </div>

                        <a class="corny-icon-button" href="#" title="Cart">
                            <img src="~/images/CartWhiteButton.png" alt="Cart" />
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(ViewData["MainClass"] ?? "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CORNY - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>